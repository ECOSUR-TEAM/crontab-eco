# Copiar a .env en el servidor de trabajo y rellenar. Nunca versionar .env.

DATABASE_URL=postgres://USUARIO:CONTRASENA@HOST:5432/NOMBRE_BASE?sslmode=require
RESEND_API_KEY=re_CAMBIAR_AQUI
REPORT_FROM="Eco <onboarding@resend.dev>"
REPORT_TO=destinatario@dominio-verificado.com
REPORT_TIMEZONE=America/Mexico_City

# rolling_week = últimos 7 días (viernes 06:00)
# calendar_month = mes natural (23:59 del último día)
# previous_calendar_month = mes natural anterior (00:00 del día 1, alternativa sin soporte de L)
REPORT_MODE=production
REPORT_PERIOD_TYPE=rolling_week
REPORT_DEDUPE=1

# Opcionales: si se definen, se valida que la URL apunte a ellos.
# REPORT_DB_NAME=NOMBRE_BASE
# REPORT_DB_USER=USUARIO
